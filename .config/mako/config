# ---------- General ----------
anchor=top-right
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=JetBrains Mono 13

# ---------- Colors (REAL VALUES, NO TEMPLATES) ----------
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa

# ---------- App Rules ----------
[app-name=Spotify]
invisible=true

# ---------- Do Not Disturb ----------
[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

# ---------- Critical Notifications ----------
[urgency=critical]
default-timeout=0
layer=overlay
border-color=#f38ba8
