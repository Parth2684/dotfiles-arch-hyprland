# ---------- General ----------
anchor=top-right
default-timeout=5000
width=420
outer-margin=24
margin=12
padding=14,18
border-size=2
border-radius=12
max-icon-size=36
font=JetBrains Mono 13

# ---------- Colors (Soft + Modern) ----------
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
progress-color=#89b4fa

# ---------- Icons ----------
icon-path=/usr/share/icons/Papirus-Dark

# ---------- App Rules ----------
[app-name=Spotify]
invisible=true

# ---------- Do Not Disturb ----------
[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

# ---------- Critical Notifications ----------
[urgency=critical]
default-timeout=0
layer=overlay
border-color=#f38ba8
background-color=#2a1a1f
text-color=#f9e2e2