// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": "Zed (Default)",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Ayu Dark",
  "autosave": {
    "after_delay": { "milliseconds": 1000 },
  },
  "format_on_save": "on",
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
  },

  // --- LSP Configuration ---
  "lsp": {
    // TypeScript / JavaScript
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 2048,
          },
          "preferences": {
            "importModuleSpecifier": "relative",
            "quoteStyle": "single",
            "autoImportFileExcludePatterns": [],
            "includePackageJsonAutoImports": "on",
            "importModuleSpecifierEnding": "minimal",
          },
          "suggest": {
            "autoImports": true,
            "completeFunctionCalls": true,
          },
          "format": {
            "indentSize": 2,
            "convertTabsToSpaces": true,
          },
          "inlayHints": {
            "parameterNames": { "enabled": "all" },
            "variableTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
          },
        },
      },
    },

    // Rust
    "rust-analyzer": {
      "settings": {
        "checkOnSave": false,
        "cargo": { "allTargets": false, "buildScripts": { "enable": false } },
        "procMacro": { "enable": false },
        "diagnostics": {
          "experimental": false,
        },
        "imports": { "granularity": { "group": "module" } },
      },
    },

    // TailwindCSS
    "tailwindcss-language-server": {
      "settings": {
        "tailwindCSS": {
          "emmetCompletions": true,
          "experimental": { "classRegex": [] },
          "validate": true,
        },
      },
    },

    // Docker
    "dockerfile-language-server": {
      "settings": {
        "docker": { "linting": { "hadolint": { "enabled": true } } },
      },
    },

    // Prisma
    "prisma-language-server": {
      "settings": {
        "prisma": { "format": true },
      },
    },
  },

  // --- Language Overrides ---
  "languages": {
    "JavaScript": {
      "language_servers": ["vtsls", "!eslint"],
    },
    "TypeScript": {
      "language_servers": ["vtsls", "!eslint"],
    },
    "TSX": {
      "language_servers": ["vtsls", "!eslint"],
    },
    "Rust": {
      "language_servers": ["rust-analyzer"],
    },
    "CSS": {
      "language_servers": ["tailwindcss-language-server"],
      "formatter": "prettier",
    },
    "HTML": {
      "language_servers": ["tailwindcss-language-server"],
      "formatter": "prettier",
    },
    "Prisma": {
      "language_servers": ["prisma-language-server"],
      "formatter": "language_server",
    },
    "Dockerfile": {
      "language_servers": ["dockerfile-language-server"],
    },
  },
}
