// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "mcp-server-code-runner": {
      "enabled": true,
      "remote": false,
      "settings": {},
    },
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
  "autosave": {
    "after_delay": { "milliseconds": 1000 },
  },
  "format_on_save": "on",
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
  },
  // "file_scan_exclusions": [
  //   "**/.git",
  //   "**/node_modules",
  //   "**/target",
  //   "**/dist",
  //   "**/build",
  // ],

  // --- LSP Configuration ---
  "lsp": {
    // Rust
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
        "numThreads": 6,
      },
      "settings": {
        "checkOnSave": false,
        "cargo": { "allTargets": false, "buildScripts": { "enable": false } },
        "procMacro": { "enable": false },
        "diagnostics": {
          "experimental": false,
        },
        "imports": { "granularity": { "group": "module" } },
      },
    },

    // TailwindCSS
    "tailwindcss-language-server": {
      "settings": {
        "tailwindCSS": {
          "emmetCompletions": true,
          "experimental": { "classRegex": [] },
          "validate": true,
        },
      },
    },

    // Docker
    "dockerfile-language-server": {
      "settings": {
        "docker": { "linting": { "hadolint": { "enabled": true } } },
      },
    },

    // Prisma
    "prisma-language-server": {
      "settings": {
        "prisma": { "format": true },
      },
    },
  },

  // --- Language Overrides ---
  "languages": {
    "JavaScript": {
      "language_servers": [
        "vtsls",
        "!tsgo",
        "!typescript-language-server",
        "eslint",
        "...",
      ],
    },
    "TypeScript": {
      "language_servers": [
        "vtsls",
        "!tsgo",
        "!typescript-language-server",
        "eslint",
        "...",
      ],
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "!tsgo",
        "!typescript-language-server",
        "eslint",
        "...",
      ],
    },
    "Rust": {
      "language_servers": ["rust-analyzer"],
    },
    "CSS": {
      "language_servers": ["tailwindcss-language-server"],
      "formatter": "prettier",
    },
    "HTML": {
      "language_servers": ["tailwindcss-language-server"],
      "formatter": "prettier",
    },
    "Prisma": {
      "language_servers": ["prisma-language-server"],
      "formatter": "language_server",
    },
    "Dockerfile": {
      "language_servers": ["dockerfile-language-server"],
    },
  },
}
